# local tool config (machine-specific, not project state)
.claude/

# build outputs
build/
cmake-build-*/
*.o
*.obj
compile_commands.json

# tools/run_native_benchmark.sh's cached Cyclone DDS source+build (M7) —
# regenerated on first run, not committed
.native-bench-cache/

# idlc-generated sources (regenerated by CMake at build time, not committed)
interfaces/generated/*.c
interfaces/generated/*.h
!interfaces/generated/.gitkeep

# raw benchmark sample dumps (regenerable; the report under
# benchmarks/reports/ is the committed evidence, not the raw capture)
benchmarks/runs/*.jsonl

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node / dashboard
node_modules/
dist/
.vite/
*.tsbuildinfo
# copied from design/tokens.css by predev/prebuild (ADR-0008) — the
# canonical source stays design/tokens.css, not this generated copy
apps/dashboard/src/tokens.css

# OS cruft
.DS_Store

# local env / secrets
.env
.env.*
