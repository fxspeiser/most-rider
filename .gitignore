# local tool config (machine-specific, not project state)
.claude/

# build outputs
build/
cmake-build-*/
*.o
*.obj
compile_commands.json

# idlc-generated sources (regenerated by CMake at build time, not committed)
interfaces/generated/*.c
interfaces/generated/*.h
!interfaces/generated/.gitkeep

# raw benchmark sample dumps (regenerable; the report under
# benchmarks/reports/ is the committed evidence, not the raw capture)
benchmarks/runs/*.jsonl

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node / dashboard
node_modules/
dist/
.vite/

# OS cruft
.DS_Store

# local env / secrets
.env
.env.*
