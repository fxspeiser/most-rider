<?xml version="1.0" encoding="UTF-8" ?>
<!--
  M0 discovery config (ADR-0002): DDS default multicast discovery is
  unreliable across Docker's default bridge networks. This disables
  multicast and lists every zone's Compose service name as an explicit
  unicast peer instead — resolved through Docker's embedded DNS on the
  shared `most-rider` network. M2 added rear-zone and cabin-zone; M3 adds
  energy-service and body-service (services, not zones — but still
  distinct DDS participants that need a peer entry to be discoverable).
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <AllowMulticast>false</AllowMulticast>
      <Interfaces>
        <NetworkInterface autodetermine="true" priority="default" multicast="false" />
      </Interfaces>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <Peers>
        <Peer Address="front-zone" />
        <Peer Address="rear-zone" />
        <Peer Address="cabin-zone" />
        <Peer Address="central" />
        <Peer Address="energy-service" />
        <Peer Address="body-service" />
        <Peer Address="load-generator" />
        <Peer Address="propulsion-monitor" />
        <Peer Address="telemetry-bridge" />
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
