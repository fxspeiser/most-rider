<?xml version="1.0" encoding="UTF-8" ?>
<!--
  M0 discovery config (ADR-0002): DDS default multicast discovery is
  unreliable across Docker's default bridge networks. This disables
  multicast and lists every zone's Compose service name as an explicit
  unicast peer instead — resolved through Docker's embedded DNS on the
  shared `most-rider` network. Add a new <Peer> entry here whenever a zone
  is added (M2 templates this away once the zone runtime is config-driven).
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <AllowMulticast>false</AllowMulticast>
      <Interfaces>
        <NetworkInterface autodetermine="true" priority="default" multicast="false" />
      </Interfaces>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <Peers>
        <Peer Address="front-zone" />
        <Peer Address="central" />
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
